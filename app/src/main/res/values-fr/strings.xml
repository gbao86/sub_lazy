    <string name="trial_guide_title">Comment annuler l\'essai</string>
    <string name="trial_guide_play_store">Ouvrez le Play Store -&gt; Appuyez sur l\'avatar supérieur -&gt; Paiements et abonnements -&gt; Abonnements -&gt; Sélectionnez%1$s-&gt; Annuler l\'abonnement.</string>
    <string name="trial_guide_apple_store">Ouvrez les paramètres de l\'iPhone -&gt; Appuyez sur votre nom -&gt; Abonnements -&gt; Sélectionnez%1$s-&gt; Annuler l\'essai.</string>
    <string name="trial_guide_netflix">Ouvrez Netflix Web -&gt; Accédez à la page Compte -&gt; Dans la section Adhésion, sélectionnez Annuler l\'adhésion.</string>
    <string name="trial_guide_spotify">Ouvrez Spotify Web -&gt; Accédez à la page Compte -&gt; Gérer l\'abonnement -&gt; Sélectionnez Modifier ou Annuler -&gt; Annuler Premium.</string>
    <string name="trial_guide_youtube">Ouvrez l\'application YouTube -&gt; Appuyez sur avatar -&gt; Achats et abonnements -&gt; Gérer l\'abonnement -&gt; Annuler l\'essai.</string>
    <string name="trial_guide_general">Ouvrez l\'application à laquelle vous vous êtes abonné -&gt; Accédez à Paramètres du compte -&gt; Plan/Facturation -&gt; Choisissez Annuler le service avant la date de renouvellement.</string>
