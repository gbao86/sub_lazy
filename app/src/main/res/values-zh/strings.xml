    <string name="trial_guide_title">如何取消试用</string>
    <string name="trial_guide_play_store">打开 Play 商店 -&gt; 点击顶部头像 -&gt; 付款和订阅 -&gt; 订阅 -&gt; 选择%1$s-&gt; 取消订阅。</string>
